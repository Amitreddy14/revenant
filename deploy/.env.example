# Copy to deploy/.env and fill in. .env is git-ignored. Never commit real values.

# The public name of your server, for example myrevenant.duckdns.org. It must already point at
# the VM's public IP address, or HTTPS certificates cannot be issued.
REVENANT_DOMAIN=

# A long random secret. Generate one on the VM:  openssl rand -hex 24
POSTGRES_PASSWORD=

# The API key clients and workers send as "Authorization: Bearer <key>" (ADR-0014).
# Generate one:  openssl rand -hex 24
REVENANT_API_KEY=

# true only if you start the optional Kafka service (docker compose --profile kafka up -d).
REVENANT_KAFKA_ENABLED=false
